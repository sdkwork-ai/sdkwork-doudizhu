SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_CORS_ALLOWED_ORIGINS=https://doudizhu.sdkwork.com,https://doudizhu.birdcoder.com,https://doudizhu.dtupay.com,https://doudizhu.noaper.com,https://doudizhu.sdkwork.cn,https://doudizhu.birdcoder.cn,https://doudizhu.dtupay.cn,https://doudizhu.noaper.cn,https://doudizhu.skubc.com,https://doudizhu.skubc.cn,https://doudizhu.zowalk.com,https://doudizhu.zowalk.cn,https://doudizhu.offer86.com,https://doudizhu.offer86.cn,https://doudizhu.86offer.com,https://doudizhu.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DOUDIZHU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_DOUDIZHU_ENVIRONMENT=production
SDKWORK_DOUDIZHU_DEPLOYMENT_PROFILE=cloud
SDKWORK_DOUDIZHU_PROFILE_ID=cloud.production
