# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_doudizhu_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_DOUDIZHU_DEPLOYMENT_PROFILE=cloud
SDKWORK_DOUDIZHU_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_DOUDIZHU_PROFILE_ID=cloud.demo
SDKWORK_DOUDIZHU_APPLICATION_PUBLIC_HTTP_URL=https://doudizhu-demo.sdkwork.com
SDKWORK_DOUDIZHU_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_DOUDIZHU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Isolation note: dedicated database schema/user `sdkwork_doudizhu_demo` and a dedicated Redis
# logical DB index `redis://127.0.0.1:6379/9` (see SDKWORK_DOUDIZHU_REDIS_URL) so no cache key
# collides with another shared-redis environment.
SDKWORK_DOUDIZHU_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_DOUDIZHU_REDIS_ENABLED=true
SDKWORK_CORS_ALLOWED_ORIGINS=https://doudizhu-demo.sdkwork.com,http://doudizhu-demo.sdkwork.com,https://doudizhu-demo.birdcoder.com,http://doudizhu-demo.birdcoder.com,https://doudizhu-demo.dtupay.com,http://doudizhu-demo.dtupay.com,https://doudizhu-demo.noaper.com,http://doudizhu-demo.noaper.com,https://doudizhu-demo.sdkwork.cn,http://doudizhu-demo.sdkwork.cn,https://doudizhu-demo.birdcoder.cn,http://doudizhu-demo.birdcoder.cn,https://doudizhu-demo.dtupay.cn,http://doudizhu-demo.dtupay.cn,https://doudizhu-demo.noaper.cn,http://doudizhu-demo.noaper.cn,https://doudizhu-demo.skubc.com,http://doudizhu-demo.skubc.com,https://doudizhu-demo.skubc.cn,http://doudizhu-demo.skubc.cn,https://doudizhu-demo.zowalk.com,http://doudizhu-demo.zowalk.com,https://doudizhu-demo.zowalk.cn,http://doudizhu-demo.zowalk.cn,https://doudizhu-demo.offer86.com,http://doudizhu-demo.offer86.com,https://doudizhu-demo.offer86.cn,http://doudizhu-demo.offer86.cn,https://doudizhu-demo.86offer.com,http://doudizhu-demo.86offer.com,https://doudizhu-demo.86offer.cn,http://doudizhu-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
